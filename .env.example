# Supabase public configuration.
# Copy to .env for local development. Never commit real credentials.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase key. Required by trusted server-side operations.
# NEVER use a service-role key in a VITE_* variable or browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# NVIDIA NIM chat model (required for AI chat).
NVIDIA_API_KEY=replace_with_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional emergency fallback when NVIDIA is unavailable. The Cloudflare Vite
# plugin/Wrangler loads the same server-only values from a root .dev.vars file.
LOVABLE_API_KEY=replace_with_lovable_api_key
LOVABLE_BASE_URL=https://ai.lovable.dev/v1
LOVABLE_MODEL=google/gemini-2.5-flash

# NVIDIA Magpie TTS. NVIDIA_API_KEY is used as fallback if no separate key is set.
NVIDIA_API_KEY_VOICE=replace_with_optional_voice_key
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
# Optional: set only to a voice identifier returned by the configured Magpie endpoint.
NVIDIA_TTS_VOICE=

# Optional audio transcription. ASR requires a deployed NVIDIA endpoint/function ID
# or a self-hosted HTTP endpoint; the API key alone does not create an endpoint.
NVIDIA_API_KEY_ASR=replace_with_optional_asr_key
NVIDIA_ASR_FUNCTION_ID=
NVIDIA_ASR_HTTP_URL=
NVIDIA_ASR_LANGUAGE=pt-BR

# Optional Web Push notifications. Both keys are required to send push messages.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@desabafo.br

# SECURITY: keep all values above server-side unless explicitly marked public.
# Never commit .env, .dev.vars, service-role keys, NVIDIA keys, or VAPID private keys.
